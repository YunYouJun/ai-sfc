OPENAI_API_KEY=
MODEL_NAME="gpt-3.5-turbo-1106"
AI_SERVICE_URL="https://api.openai.com/v1"

# Yunle SSO v3（clientId 与精确 HTTPS 回调地址必须登记在 Provider Client Registry）
NUXT_PUBLIC_YUNLE_SSO_CLIENT_ID="ai-sfc-web"
NUXT_PUBLIC_YUNLE_SSO_ORIGIN="https://www.yunle.fun"
NUXT_PUBLIC_YUNLE_SSO_EXCHANGE_URL="https://api.yunle.fun/sso-ticket"
# 留空时使用当前站点 origin 的根路径，例如 https://ai-sfc.yunle.fun/
NUXT_PUBLIC_YUNLE_SSO_REDIRECT_URI=
